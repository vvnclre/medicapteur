---
pagination: { data: langs, size: 1, alias: lang }
permalink: "{{ 'contact' | url(lang) }}"
layout: layouts/base.njk
routeKey: contact
eleventyComputed:
  title: "{{ copy.contact.title | t(lang) }}"
  description: "{{ copy.contact.description | t(lang) }}"
---
{%- import "macros.njk" as m -%}
{%- set C = copy.contact -%}
{{ m.head(C.eyebrow | t(lang), C.h1 | t(lang), C.lead | t(lang)) }}
<section class="wrap" style="padding-bottom:40px">
  <div class="quote">
    <div class="quote__t"><strong>{{ C.reqTitle | t(lang) }}</strong><span>{{ C.reqText | t(lang) }}</span></div>
    <a class="mc-btn mc-btn--primary" href="{{ 'request' | url(lang) }}"><span class="mc-sensor"></span>{{ ui.cta | t(lang) }}</a>
  </div>
</section>
<section class="wrap" style="padding-bottom:48px">
  <span class="mc-eyebrow" style="margin-bottom:14px">{{ 'Par service' if lang == 'fr' else 'By department' }}</span>
  <div class="tiles">
    {% for s in C.services %}<div class="tile"><b>{{ s.b | t(lang) }}</b><a class="tel" href="tel:{{ s.tel | replace(' ', '') }}">{{ s.tel }}</a><span class="mail">{{ s.mail }}</span>{% if s.check %}<span><span class="check">{{ ui.toConfirm | t(lang) }}</span></span>{% endif %}{% if s.s %}<span>{{ s.s | t(lang) }}</span>{% endif %}</div>{% endfor %}
  </div>
</section>
<section class="sec sec--alt">
  <div class="wrap">
    <div class="sec-h"><div><span class="mc-eyebrow">{{ C.where | t(lang) }}</span><h2 class="h2">Balma · Sophia Antipolis</h2></div></div>
    <div class="tiles">
      <div class="tile" style="background:var(--surface)"><b>Medicapteurs France SAS</b><span>{{ C.hq | t(lang) }}</span><span>18 avenue Prat Gimont, 31130 Balma, France <span class="check">{{ ui.toConfirm | t(lang) }}</span></span><a class="tel" href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></div>
      <div class="tile" style="background:var(--surface)"><b>Medicapteurs Nice</b><span>{{ C.agencyName | t(lang) }}</span><span>Centre d'affaires BSS, 120 route des Macarons, 06560 Sophia Antipolis Valbonne</span><a class="tel" href="tel:+33492946823">{{ site.phonePosturo }}</a></div>
      <div class="tile" style="background:var(--surface)"><b>Export</b><span>{{ C.abroad | t(lang) }}</span><span class="mail">{{ site.emailExport }}</span></div>
    </div>
  </div>
</section>
<section class="wrap sec">
  <div class="tiles">
    <a class="tile tile--link" href="{{ 'support' | url(lang) }}"><b>{{ C.supportTitle | t(lang) }}</b><span>{{ 'Hotline, code licence, FAQ, configuration PC' if lang == 'fr' else 'Hotline, licence code, FAQ, PC requirements' }}</span></a>
    <a class="tile tile--link" href="{{ 'distribution' | url(lang) }}"><b>{{ ui.nav.distribution | t(lang) }}</b><span>{{ pages.distribution.abroadText | t(lang) }}</span></a>
    <a class="tile tile--link" href="{{ 'downloads' | url(lang) }}"><b>{{ ui.nav.downloads | t(lang) }}</b><span>{{ pages.downloads.lead | t(lang) }}</span></a>
  </div>
</section>
