---
pagination: { data: productPages, size: 1, alias: item }
permalink: "{{ 'product' | url(item.lang, item.product.slug) }}"
layout: layouts/base.njk
routeKey: product
eleventyComputed:
  lang: "{{ item.lang }}"
  slug: "{{ item.product.slug }}"
  title: "{{ item.product.name }} · {{ item.product.tagline | t(item.lang) | replace(r/\\.$/, '') }}"
  description: "{{ item.product.summary | t(item.lang) }}"
---
{%- import "macros.njk" as m -%}
{%- set p = item.product -%}
{%- set C = copy.product -%}
{%- set F = ui.families[p.family] -%}
<section class="wrap p-hero">
  <div class="p-hero__copy">
    <nav class="crumbs" aria-label="{{ 'Fil d’Ariane' if lang == 'fr' else 'Breadcrumb' }}"><a href="{{ 'range' | url(lang) }}">{{ ui.nav.products | t(lang) }}</a><span aria-hidden="true">/</span><a href="{{ 'range' | url(lang) }}#{{ p.family }}">{{ F.eyebrow | t(lang) }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ p.name }}</span></nav>
    <span class="card-name"><span class="mc-product p-hero__name"><span class="mc-sensor"></span>{{ p.name }}</span>{% if p.isNew %}<span class="tag-new">{{ ui.isNew | t(lang) }}</span>{% endif %}</span>
    <h1 class="h1">{{ p.tagline | t(lang) }}</h1>
    <p class="lead">{{ p.summary | t(lang) }}</p>
    {% if p.key.length %}
    <div class="p-hero__key">
      {% for k in p.key %}<div class="mc-measure"><b>{{ k.value | loc(lang) }}{% if k.unit %}<span>{{ k.unit | t(lang) }}</span>{% endif %}</b><em>{{ k.label | t(lang) }}</em></div>{% endfor %}
    </div>
    {% endif %}
    <div class="p-hero__btns">
      <a class="mc-btn mc-btn--primary mc-btn--lg" href="{{ 'request' | url(lang) }}?produit={{ p.slug }}"><span class="mc-sensor"></span>{{ C.demo | t(lang) }}<span class="mc-cells" aria-hidden="true"><i></i><i></i><i></i></span></a>
      <a class="mc-btn mc-btn--link" href="#fiche">{{ C.seeSpecs | t(lang) }}</a>
    </div>
  </div>
  <div class="p-hero__media"><img src="/assets/img/{{ p.image }}" alt="{{ p.name }}" width="800" height="600"></div>
</section>

<nav class="subnav" aria-label="{{ 'Sections de la fiche' if lang == 'fr' else 'Page sections' }}">
  <div class="wrap">
    <a href="#description">{{ C.overview | t(lang) }}</a>
    {% if p.software %}<a href="#logiciel">{{ C.software | t(lang) }}</a>{% endif %}
    <a href="#fiche">{{ C.specs | t(lang) }}</a>
    {% if p.docs.length %}<a href="#documents">{{ C.docs | t(lang) }}</a>{% endif %}
    {% if p.studies %}<a href="#etudes">{{ C.studies | t(lang) }}</a>{% endif %}
    <a href="#devis">{{ C.quote | t(lang) }}</a>
  </div>
</nav>

<section id="description" class="wrap sec">
  <div class="p-desc">
    <div class="prose">
      <span class="mc-eyebrow">{{ C.overview | t(lang) }}</span>
      {% for para in p.intro %}<p>{{ para | t(lang) }}</p>{% endfor %}
    </div>
    {% if p.gallery and p.gallery.length %}<figure class="p-desc__img"><img src="/assets/img/{{ p.gallery[0] }}" alt="{{ p.name }}" loading="lazy"></figure>{% endif %}
  </div>
  {% if p.highlights.length %}
  <div class="hl-grid">
    {% for g in p.highlights %}
    <div class="hl">
      <h2 class="h3">{{ g.title | t(lang) }}</h2>
      <ul class="ticks">{% for it in g.items %}<li>{{ it | t(lang) }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

{% if p.software %}
<section id="logiciel" class="dark-sec mc-on-inverse sec">
  <div class="wrap soft">
    <div class="soft__head">
      <span class="mc-eyebrow">{{ C.softwareEyebrow | t(lang) }}</span>
      <h2 class="h2">{{ p.software.name | t(lang) }}</h2>
      {% for para in p.software.intro %}<p class="soft__intro">{{ para | t(lang) }}</p>{% endfor %}
      <p class="soft__note">{{ C.softwareNote | t(lang) }}</p>
    </div>
    {% if p.software.groups.length %}
    <div class="soft__groups">
      {% for g in p.software.groups %}
      <div><span class="mc-product soft__k"><span class="mc-sensor"></span>{{ g.title | t(lang) }}</span><ul class="ticks ticks--dark">{% for it in g.items %}<li>{{ it | t(lang) }}</li>{% endfor %}</ul></div>
      {% endfor %}
    </div>
    {% endif %}
    {% if p.family != 'mobile' and p.slug not in ['w-inshoe', 'w-inshoe-easy', 'win-posturo'] %}<img class="shot" src="/assets/img/soft-dynamiq.jpg" alt="{{ C.softwareAlt | t(lang) }}" width="1400" height="788" loading="lazy">{% endif %}
  </div>
</section>
{% endif %}

<section id="fiche" class="wrap sec">
  <div class="sec-h"><div><span class="mc-eyebrow">{{ C.specs | t(lang) }}</span><h2 class="h2">{{ C.specTitle | t(lang) }} {{ p.name }}</h2></div></div>
  {% if p.specs.length %}
  <div class="spec-grid">
    {% for g in p.specs %}
    <table class="mc-spec">
      <caption>{{ g.title | t(lang) }}</caption>
      {% for s in g.rows %}<tr><th scope="row">{{ s.label | t(lang) }}</th><td>{{ s.value | t(lang) | loc(lang) }}{% if s.check %} <span class="check">{{ ui.toConfirm | t(lang) }}</span>{% endif %}</td></tr>{% endfor %}
    </table>
    {% endfor %}
    {% if p.options.length %}
    <div class="opts-box">
      <span class="mc-eyebrow">{{ C.options | t(lang) }}</span>
      <ul class="ticks">{% for o in p.options %}<li>{{ o | t(lang) }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
  </div>
  <p class="note" style="margin-top:16px">{{ C.specIntro | t(lang) }}</p>
  {% else %}
  <div class="missing"><strong>{{ C.missingTitle | t(lang) }}</strong><span>{{ C.missingText | t(lang) }}</span></div>
  {% endif %}
</section>

{% if p.docs.length %}
<section id="documents" class="wrap" style="padding-bottom:48px">
  <span class="mc-eyebrow" style="margin-bottom:14px">{{ C.docs | t(lang) }}</span>
  <div class="docs">{% for d in p.docs %}<a class="doc" href="{{ d.url }}" target="_blank" rel="noopener"><span class="doc__ic" aria-hidden="true">PDF</span><span>{{ d.label | t(lang) }}</span></a>{% endfor %}</div>
</section>
{% endif %}

<section id="devis" class="wrap" style="padding-bottom:56px">
  <div class="quote">
    <div class="quote__t"><strong>{{ C.quoteTitle | t(lang) }} {{ p.name }}</strong><span>{{ C.quoteText | t(lang) }}</span></div>
    <div class="quote__price">
      {% if p.price %}<small>{{ p.price.note | t(lang) }}</small><b>{{ p.price.value | t(lang) }}</b>{% if p.price.check %}<small><span class="check">{{ ui.toConfirm | t(lang) }}</span></small>{% endif %}
      {% else %}<b style="font-size:20px">{{ C.onRequest | t(lang) }}</b>{% endif %}
    </div>
    <a class="mc-btn mc-btn--primary" href="{{ 'request' | url(lang) }}?produit={{ p.slug }}"><span class="mc-sensor"></span>{{ ui.cta | t(lang) }}</a>
  </div>
</section>

{% if p.studies %}
<section id="etudes" class="sec sec--alt">
  <div class="wrap"><div class="sec-h" style="margin:0;align-items:center">
    <div><span class="mc-eyebrow">{{ C.studies | t(lang) }}</span><p class="h2"><span class="num">{{ p.studies }}</span> {{ C.studiesText | t(lang) }}</p></div>
    <a class="mc-btn mc-btn--secondary" href="{{ 'studies' | url(lang) }}"><span class="mc-sensor"></span>{{ C.studiesLink | t(lang) }}</a>
  </div></div>
</section>
{% endif %}

{% if p.related.length %}
<section class="wrap sec">
  <span class="mc-eyebrow" style="margin-bottom:16px">{{ C.related | t(lang) }}</span>
  {{ m.chips(p.related, products, lang) }}
</section>
{% endif %}
