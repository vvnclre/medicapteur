---
pagination: { data: prepPages, size: 1, alias: item }
permalink: "{{ item.key | url(item.lang) }}"
layout: layouts/base.njk
eleventyComputed:
  lang: "{{ item.lang }}"
  routeKey: "{{ item.key }}"
  title: "{{ copy.prep[item.key].title | t(item.lang) }}"
  description: "{{ copy.prep[item.key].description | t(item.lang) }}"
---
{%- set C = copy.prep[item.key] -%}
<section class="wrap page-head">
  <span class="mc-eyebrow">{{ C.eyebrow | t(lang) }}</span>
  <h1 class="h1 statement" style="font-size:40px;line-height:50px;font-weight:400">{{ C.h1 | t(lang) }}</h1>
  <p class="lead">{{ C.lead | t(lang) }}</p>
</section>
<section class="wrap" style="padding-bottom:56px">
  <div class="prep">
    <div class="prep__list">
      {% for pt in C.points %}<div class="li dots" style="flex-direction:column;gap:4px;padding:18px 0"><strong class="h3" style="font-size:19px">{{ pt.b | t(lang) }}</strong><span class="muted" style="font-size:16px;line-height:24px">{{ pt.s | t(lang) }}</span></div>{% endfor %}
      {% if item.key == 'legal' %}
      <div class="prose" id="donnees">
        <h2>{{ 'Éditeur' if lang == 'fr' else 'Publisher' }}</h2>
        <p>Medicapteurs · {{ site.address }} · <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></p>
        <h2>{{ 'Données personnelles' if lang == 'fr' else 'Personal data' }}</h2>
        <p>{{ 'Les informations envoyées par le formulaire « Préparer ma demande » servent uniquement à vous répondre. Politique complète à fournir par Medicapteurs.' if lang == 'fr' else 'Information sent through the “Prepare my request” form is only used to reply to you. Full policy to be provided by Medicapteurs.' }}</p>
      </div>
      {% endif %}
    </div>
    <div class="stack">
      {% if item.image %}<img src="/assets/img/{{ item.image }}" alt="" width="800" height="500" style="border-radius:var(--radius-plate);background:var(--surface-alt)" loading="lazy">{% endif %}
      {% if item.key != 'legal' %}
      <div class="tile">
        <b>{{ copy.prep.nextTitle | t(lang) }}</b>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px">
          <a class="mc-btn mc-btn--primary mc-btn--sm" href="{{ 'request' | url(lang) }}"><span class="mc-sensor"></span>{{ ui.cta | t(lang) }}</a>
          <a class="mc-btn mc-btn--secondary mc-btn--sm" href="{{ 'range' | url(lang) }}"><span class="mc-sensor"></span>{{ copy.prep.nextRange | t(lang) }}</a>
        </div>
        <span style="margin-top:6px">{{ copy.prep.nextCall | t(lang) }} : <a class="tel" href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></span>
      </div>
      {% endif %}
    </div>
  </div>
</section>
