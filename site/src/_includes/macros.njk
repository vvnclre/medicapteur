{% macro head(eyebrow, h1, lead, statement=false) %}
<section class="wrap page-head">
  <span class="mc-eyebrow">{{ eyebrow }}</span>
  <h1 class="h1{% if statement %} statement page-head__statement{% endif %}">{{ h1 }}</h1>
  {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
</section>
{% endmacro %}

{% macro cta(ui, copy, lang, title=null, text=null, site=null) %}
<section class="wrap" style="padding-top:48px;padding-bottom:64px">
  <div class="cta-band">
    <div class="cta-band__main">
      <h2 class="cta-band__t">{{ title or (copy.home.ctaTitle | t(lang)) }}</h2>
      <p>{{ text or (copy.home.ctaText | t(lang)) }}</p>
      <ul class="cta-band__list">{% for it in copy.home.ctaItems %}<li><b>{{ it.b | t(lang) }}</b><span>{{ it.s | t(lang) }}</span></li>{% endfor %}</ul>
    </div>
    <div class="cta-band__side">
      <a class="mc-btn mc-btn--ink mc-btn--lg" href="{{ 'request' | url(lang) }}"><span class="mc-sensor"></span>{{ ui.cta | t(lang) }}<span class="mc-cells" aria-hidden="true"><i></i><i></i><i></i></span></a>
      <span class="cta-band__or">{{ copy.home.ctaCall | t(lang) }}</span>
      <a class="cta-band__tel" href="tel:+33562571571">+33 5 62 571 571</a>
    </div>
    <div class="cta-band__print" aria-hidden="true"><div class="step" data-step="0"></div><div class="step step--r" data-step="0"></div></div>
  </div>
</section>
{% endmacro %}

{% macro chips(slugs, products, lang) %}
<div class="related">
  {% for s in slugs %}{% set r = products | bySlug(s) %}
  <a class="mc-plate" href="{{ 'product' | url(lang, r.slug) }}"><img src="/assets/img/{{ r.image }}" alt="" width="72" height="54" loading="lazy"><span><span class="mc-product" style="font-size:13px">{{ r.name }}</span><small>{{ r.short | t(lang) }}</small></span></a>
  {% endfor %}
</div>
{% endmacro %}
